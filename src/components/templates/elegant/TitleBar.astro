---
import type { PersonalInfo } from '@/types/cv'

interface Props {
  data: PersonalInfo
}
const { data } = Astro.props
---

<div class='eg-titlebar'>
  <div class='eg-role'>{data.title}</div>
  <div class='eg-place'>
    <svg class='eg-pin' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.9' stroke-linecap='round' stroke-linejoin='round'>
      <path d='M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0116 0z' />
      <circle cx='12' cy='10' r='3' />
    </svg>
    <span>
      {data.location}
      {data.workRights && <><br />{data.workRights}</>}
    </span>
  </div>
</div>
