---
import type { ContactProps } from '@/types/cv'

interface Props extends ContactProps {}
const { data } = Astro.props

/*
 * The strip must stay on one line, so display shortened handles rather than
 * full URLs. The data keeps the real, clickable values.
 */
const short = (url?: string) =>
  (url ?? '').replace(/^https?:\/\//, '').replace(/^www\./, '').replace(/\/$/, '')
const linkedinHandle = (url?: string) => {
  const path = short(url)
  const match = path.match(/linkedin\.com\/(in\/[^/]+)/)
  return match ? match[1] : path
}
---

<div class='eg-strip'>
  {
    data.email && (
      <span class='eg-chip'>
        <span class='eg-ico'>
          <svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
            <rect x='2' y='4' width='20' height='16' rx='2' />
            <path d='M22 6l-10 7L2 6' />
          </svg>
        </span>
        {data.email}
      </span>
    )
  }
  {
    data.phone && (
      <span class='eg-chip'>
        <span class='eg-ico'>
          <svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
            <path d='M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.4 1.8.7 2.7a2 2 0 01-.5 2.1L8.1 9.8a16 16 0 006 6l1.3-1.2a2 2 0 012.1-.5c.9.3 1.8.6 2.7.7a2 2 0 011.8 2.1z' />
          </svg>
        </span>
        {data.phone}
      </span>
    )
  }
  {
    data.website && (
      <span class='eg-chip'>
        <span class='eg-ico'>
          <svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
            <circle cx='12' cy='12' r='10' />
            <path d='M2 12h20M12 2a15 15 0 010 20 15 15 0 010-20' />
          </svg>
        </span>
        {short(data.website)}
      </span>
    )
  }
  {
    data.github && (
      <span class='eg-chip'>
        <span class='eg-ico'>
          <svg viewBox='0 0 24 24' fill='currentColor'>
            <path d='M12 2A10 10 0 002 12c0 4.42 2.87 8.17 6.84 9.5.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.5 9.5 0 015 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0022 12 10 10 0 0012 2z' />
          </svg>
        </span>
        {short(data.github)}
      </span>
    )
  }
  {
    data.linkedin && (
      <span class='eg-chip'>
        <span class='eg-ico'>
          <svg viewBox='0 0 24 24' fill='currentColor'>
            <path d='M4.98 3.5A2.5 2.5 0 002.5 6a2.5 2.5 0 002.48 2.5A2.5 2.5 0 007.5 6a2.5 2.5 0 00-2.52-2.5zM3 9h4v12H3V9zm6 0h3.8v1.65h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.5c0-1.31-.03-3-1.83-3-1.84 0-2.12 1.43-2.12 2.9V21H9V9z' />
          </svg>
        </span>
        {linkedinHandle(data.linkedin)}
      </span>
    )
  }
</div>
